# Supabase project URL and service-role key (Project Settings → API).
# The service-role key is server-only. Never expose it with a NEXT_PUBLIC_ prefix.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters. Signs session cookies and keys the IP hash.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. If set, read-only viewers must open the app once with ?k=<VIEW_KEY>.
VIEW_KEY=
